---
const year = new Date().getFullYear();

const nav1 = [
  { href: "/about", label: "組織について" },
  { href: "/shops", label: "加盟店" },
  { href: "/coin", label: "Akiba Coin" },
];

const nav2 = [
  { href: "/events", label: "イベント" },
  { href: "/rules", label: "会員規則" },
  { href: "/join", label: "会員登録" },
];

const nav3 = [
  { href: "/contact", label: "お問い合わせ" },
  { href: "#", label: "プライバシーポリシー" },
  { href: "#", label: "特定商取引法" },
];

const sns = [
  {
    href: "#",
    label: "X (Twitter)",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    href: "#",
    label: "Instagram",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  },
  {
    href: "#",
    label: "YouTube",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
];
---

<footer class="bg-black border-t border-white/10 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">

    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="32" height="32" rx="6" fill="#e8546a"/>
            <path d="M8 24L16 8L24 24" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M10.5 19H21.5" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
          <span class="font-bold text-white text-base tracking-tight">AKIBA JAPAN</span>
        </a>
        <p class="text-white/50 text-sm leading-relaxed">
          秋葉原から世界へ。<br/>
          コミュニティと文化をつなぐNPO。
        </p>

        <!-- SNS -->
        <div class="flex items-center gap-3 mt-5">
          {sns.map(({ href, label, icon }) => (
            <a
              href={href}
              aria-label={label}
              class="text-white/40 hover:text-primary transition-colors"
              set:html={icon}
            />
          ))}
        </div>
      </div>

      <!-- Nav columns -->
      <div>
        <h3 class="text-xs font-semibold text-white/30 uppercase tracking-widest mb-4">組織</h3>
        <ul class="space-y-2">
          {nav1.map(({ href, label }) => (
            <li>
              <a href={href} class="text-white/60 hover:text-white text-sm transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold text-white/30 uppercase tracking-widest mb-4">活動</h3>
        <ul class="space-y-2">
          {nav2.map(({ href, label }) => (
            <li>
              <a href={href} class="text-white/60 hover:text-white text-sm transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold text-white/30 uppercase tracking-widest mb-4">サポート</h3>
        <ul class="space-y-2">
          {nav3.map(({ href, label }) => (
            <li>
              <a href={href} class="text-white/60 hover:text-white text-sm transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <div class="border-t border-white/10 mt-12 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-white/30 text-xs">
        &copy; {year} NPO法人国際AKIBA総合支援協会. All rights reserved.
      </p>
      <p class="text-white/20 text-xs">AKIBA JAPAN</p>
    </div>

  </div>
</footer>
