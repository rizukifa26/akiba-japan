---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, type Lang } from "../../i18n/translations";

interface Props {
  lang?: "ja" | "en";
}

const { lang = "ja" } = Astro.props;
const t = useTranslations(lang);
const h = t.home;

const base = lang === "en" ? "/en" : "/jp";
const href = (path: string) => `${base}${path}`;
---

<BaseLayout title={h.pageTitle} description={h.pageDescription} lang={lang}>

  <!-- ─── SECTION 1: HERO ─────────────────────────────── -->
  <section id="hero" class="relative flex flex-col justify-center overflow-hidden bg-black min-h-[calc(100vh-4rem)]">

    <!-- Background image -->
    <img
      src="/akiba-japan/haikei.png"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <!-- Dark overlay for text readability -->
    <div class="absolute inset-0 bg-black/55" aria-hidden="true"></div>
    <!-- Radial gradient overlay -->
    <div class="hero-glow absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-10 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-24 flex flex-col justify-between gap-16">

      <!-- Main content -->
      <div class="max-w-3xl">

        <!-- Eyebrow -->
        <div class="flex items-center gap-2.5 mb-8">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse shrink-0" aria-hidden="true"></span>
          <span class="text-primary font-mono text-xs tracking-[0.2em] uppercase">{h.eyebrow}</span>
        </div>

        <!-- H1 -->
        {lang === "ja" ? (
          <h1 class="hero-heading font-black leading-[1.05] tracking-tight mb-7">
            {h.heroLine1}<span class="text-primary">{h.heroHighlight}</span>{h.heroLine2}<br/>
            {h.heroLine3}
          </h1>
        ) : (
          <h1 class="hero-heading font-black leading-[1.05] tracking-tight mb-7">
            {h.heroLine1}<br/>
            {h.heroLine3}
          </h1>
        )}

        <!-- Lead -->
        <p class="text-white/55 text-lg sm:text-xl leading-relaxed max-w-2xl mb-10">
          {h.heroLead}
        </p>

        <!-- CTA buttons -->
        <div class="flex flex-wrap gap-4">
          <a
            href={href("/shops")}
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg bg-primary hover:bg-primary-dark text-white font-semibold text-sm transition-colors duration-200 shadow-lg shadow-primary/20"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.8"/>
              <path d="M10 10l3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            {h.ctaFind}
          </a>
          <a
            href={href("/join")}
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg border border-white/30 hover:border-white/60 hover:bg-white/5 text-white font-semibold text-sm transition-colors duration-200"
          >
            {h.ctaJoin}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Stats row -->
      <div class="border-t border-white/10 pt-8">
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-0 sm:divide-x sm:divide-white/10">
          {h.stats.map(({ value, label }) => (
            <div class="sm:px-8 first:pl-0 last:pr-0">
              <dt class="text-white/40 text-xs tracking-widest uppercase mb-1">{label}</dt>
              <dd class="text-white font-mono font-bold text-3xl sm:text-4xl leading-none">{value}</dd>
            </div>
          ))}
        </dl>
      </div>

    </div>
  </section>

  <!-- ─── SECTION 2: MISSION ─────────────────────────── -->
  <section id="mission" class="py-24 bg-[#0a0a0a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section header -->
      <div class="mb-14">
        <p class="text-primary font-mono text-xs tracking-[0.2em] uppercase mb-3">{h.missionEyebrow}</p>
        <h2 class="text-3xl sm:text-4xl font-black text-white">{h.missionTitle}</h2>
      </div>

      <!-- Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {h.missions.map(({ number, title, desc }) => (
          <article class="bg-white rounded-2xl p-8 flex flex-col gap-5 group hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="flex items-center gap-3">
              <span class="text-primary font-mono text-xs font-bold tracking-widest">MISSION</span>
              <span class="font-mono text-2xl font-black text-black/10">{number}</span>
            </div>
            <h3 class="text-black font-black text-xl leading-tight">{title}</h3>
            <p class="text-black/60 text-sm leading-relaxed flex-1">{desc}</p>
            <div class="w-8 h-0.5 bg-primary group-hover:w-16 transition-all duration-300 rounded-full"></div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── SECTION 3: ABOUT TEASER ───────────────────── -->
  <section id="about-teaser" class="py-24 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">

        <p class="text-primary font-mono text-xs tracking-[0.2em] uppercase mb-4">{h.aboutEyebrow}</p>
        <h2 class="text-3xl sm:text-4xl font-black text-black leading-tight mb-6">
          {h.aboutTitle.split("\n").map((line, i) => (
            i === 0 ? <>{line}<br/></> : line
          ))}
        </h2>
        <p class="text-black/60 text-base sm:text-lg leading-relaxed mb-4">
          {h.aboutBody1}
        </p>
        <p class="text-black/60 text-base sm:text-lg leading-relaxed mb-10">
          {h.aboutBody2}
        </p>

        <a
          href={href("/about")}
          class="inline-flex items-center gap-2 text-primary font-semibold text-sm hover:gap-3 transition-all duration-200 group"
        >
          {h.aboutCTA}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

      </div>
    </div>
  </section>

  <!-- ─── SECTION: CHIHOU RENKEI TEASER ──────────────── -->
  <section class="py-16 sm:py-20 bg-[#0d1623] relative overflow-hidden">
    <div class="absolute inset-0 chihou-grid opacity-40" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">

        <div class="max-w-xl">
          <p class="text-primary font-mono text-xs tracking-[0.2em] uppercase mb-3">{h.chihouEyebrow}</p>
          <h2 class="text-2xl sm:text-3xl font-black text-white leading-tight mb-4">
            {h.chihouTitle}
          </h2>
          <p class="text-white/60 text-sm sm:text-base leading-relaxed">
            {h.chihouBody}
          </p>
        </div>

        <div class="flex flex-wrap gap-3 shrink-0">
          <a
            href={href("/about#chihou")}
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg bg-primary hover:bg-primary-dark text-white font-semibold text-sm transition-colors duration-200 shadow-lg shadow-primary/20"
          >
            {h.chihouCTA}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a
            href="/akiba-japan-flyer.pdf"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg border border-white/30 hover:border-white/60 hover:bg-white/5 text-white font-semibold text-sm transition-colors duration-200"
          >
            {h.flyerCTA}
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── SECTION 4: COIN TEASER ────────────────────── -->
  <section id="coin-teaser" class="py-24 bg-black relative overflow-hidden">

    <!-- Decorative coin glow -->
    <div class="absolute top-1/2 right-0 -translate-y-1/2 w-96 h-96 rounded-full bg-primary/5 blur-3xl" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <!-- Left: description -->
        <div>
          <p class="text-primary font-mono text-xs tracking-[0.2em] uppercase mb-4">{h.coinEyebrow}</p>
          <h2 class="text-3xl sm:text-4xl font-black text-white leading-tight mb-6">
            {h.coinTitle.split("\n").map((line, i) => (
              i === 0 ? <>{line}<br/></> : <span class="text-white/50">{line}</span>
            ))}
          </h2>
          <p class="text-white/55 text-base sm:text-lg leading-relaxed mb-6">
            {h.coinBody}
          </p>
          <ul class="space-y-3 mb-10">
            {h.coinFeatures.map((item) => (
              <li class="flex items-start gap-3 text-white/70 text-sm">
                <svg class="shrink-0 mt-0.5" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <circle cx="8" cy="8" r="7" stroke="#e8546a" stroke-width="1.5"/>
                  <path d="M5 8l2 2 4-4" stroke="#e8546a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <a
            href={href("/coin")}
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg border border-primary text-primary hover:bg-primary hover:text-white font-semibold text-sm transition-colors duration-200"
          >
            {h.coinDetailCTA}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <!-- Right: simple coin info -->
        <div class="rounded-2xl border border-white/10 bg-white/5 p-8 flex flex-col gap-6 text-white">
          <p class="text-xl font-black leading-snug">
            {h.coinUsageTitle}<br/>
            <span class="text-white/60 font-semibold text-base">{h.coinUsageSubtitle}</span>
          </p>

          <div class="border-t border-white/10 pt-6 flex flex-col gap-2">
            <p class="font-bold text-sm text-primary flex items-center gap-2">{h.coinUsageMethodLabel}</p>
            <p class="text-white/70 text-sm leading-relaxed">{h.coinUsageMethodBody}</p>
          </div>

          <div class="border-t border-white/10 pt-6 flex flex-col gap-2">
            <p class="font-bold text-sm text-primary flex items-center gap-2">{h.coinUsageExampleLabel}</p>
            <p class="text-white/70 text-sm leading-relaxed">
              {h.coinUsageExampleBody.split("\n").map((line, i) => (
                i === 0 ? <>{line}<br/></> : <span class="text-white font-semibold">{line}</span>
              ))}
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── SECTION 5: CTA FINAL ──────────────────────── -->
  <section id="cta-final" class="py-24 bg-primary relative overflow-hidden">

    <!-- Decorative background shapes -->
    <div class="absolute top-0 right-0 w-72 h-72 rounded-full bg-white/5 -translate-y-1/2 translate-x-1/4" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full bg-black/10 translate-y-1/2 -translate-x-1/4" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">

      <p class="text-white/70 font-mono text-xs tracking-[0.2em] uppercase mb-5">{h.finalCtaEyebrow}</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-tight mb-5">
        {h.finalCtaTitle.split("\n").map((line, i) => (
          i === 0 ? <>{line}<br/></> : line
        ))}
      </h2>
      <p class="text-white/75 text-lg max-w-xl mx-auto mb-12 leading-relaxed text-balance">
        {h.finalCtaBody}
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={href("/join")}
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg bg-white text-primary hover:bg-white/90 font-bold text-sm transition-colors duration-200 shadow-lg"
        >
          {h.finalCtaIndividual}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href={href("/join")}
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg border-2 border-white/60 hover:border-white hover:bg-white/10 text-white font-bold text-sm transition-colors duration-200"
        >
          {h.finalCtaCorporate}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .hero-glow {
    background:
      radial-gradient(ellipse at 85% 35%, rgba(232, 84, 106, 0.18) 0%, transparent 55%),
      radial-gradient(ellipse at 8% 80%, rgba(0, 210, 200, 0.09) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 0%, rgba(232, 84, 106, 0.06) 0%, transparent 40%);
  }

  .hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }

  .chihou-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 44px 44px;
  }
</style>
