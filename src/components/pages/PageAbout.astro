---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, type Lang } from "../../i18n/translations";

interface Props {
  lang?: "ja" | "en";
}

const { lang = "ja" } = Astro.props;
const t = useTranslations(lang);
const a = t.about;

const base = lang === "en" ? "/en" : "/jp";
const href = (path: string) => `${base}${path}`;
---

<BaseLayout title={a.pageTitle} description={a.pageDescription} lang={lang}>

  <!-- ─── HERO ─────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-black py-28">
    <div class="hero-grid absolute inset-0" aria-hidden="true"></div>
    <div class="hero-glow absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2.5 mb-6">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse shrink-0" aria-hidden="true"></span>
        <span class="text-primary font-mono text-xs tracking-[0.2em] uppercase">{a.eyebrow}</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-[1.1] tracking-tight mb-6">
        {a.heroTitle.split("\n").map((line, i) => (
          i === 0 ? <>{line}<br/></> : <span class="text-primary">{line}</span>
        ))}
      </h1>
      <p class="text-white/60 text-lg sm:text-xl leading-relaxed max-w-2xl">
        {a.heroBody}
      </p>
    </div>
  </section>

  <!-- ─── HISTORY ──────────────────────────────────────── -->
  <section class="py-24 bg-[#0a0a0a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

        <!-- Left: text -->
        <div>
          <p class="text-primary font-mono text-xs tracking-[0.2em] uppercase mb-3">{a.historyEyebrow}</p>
          <h2 class="text-3xl sm:text-4xl font-black text-white mb-6 leading-tight">
            {a.historyTitle.split("\n").map((line, i) => (
              i === 0 ? <>{line}<br/></> : line
            ))}
          </h2>
          <p class="text-white/60 leading-relaxed mb-5">
            {a.historyBody1}
          </p>
          <p class="text-white/60 leading-relaxed">
            {a.historyBody2}
          </p>
        </div>

        <!-- Right: timeline -->
        <div>
          {a.history.map(({ era, label, desc }, i) => (
            <div class="flex gap-5">
              <div class="flex flex-col items-center">
                <div class="w-3 h-3 rounded-full bg-primary shrink-0 mt-1.5"></div>
                {i < a.history.length - 1 && (
                  <div class="w-px flex-1 bg-white/10 my-2"></div>
                )}
              </div>
              <div class={i < a.history.length - 1 ? "pb-8" : ""}>
                <p class="text-primary font-mono text-xs tracking-widest uppercase mb-1">{era}</p>
                <p class="text-white font-bold text-base mb-1">{label}</p>
                <p class="text-white/50 text-sm leading-relaxed">{desc}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ─── OUR STORY ────────────────────────────────────── -->
  <section class="py-24 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-16 items-start">

        <div>
          <p class="text-primary font-mono text-xs tracking-[0.2em] uppercase mb-3">{a.storyEyebrow}</p>
          <h2 class="text-3xl sm:text-4xl font-black text-black leading-tight">
            {a.storyTitle.split("\n").map((line, i) => (
              i === 0 ? <>{line}<br/></> : line
            ))}
          </h2>
        </div>

        <div class="flex flex-col gap-5">
          <p class="text-black/65 text-lg leading-relaxed">
            {a.storyBody1}
          </p>
          <p class="text-black/65 text-lg leading-relaxed">
            {a.storyBody2}
          </p>
          <p class="text-black/65 text-lg leading-relaxed">
            {a.storyBody3}
          </p>

          <!-- Established badge -->
          <div class="mt-4 inline-flex items-center gap-3 border border-black/10 rounded-xl px-5 py-3 w-fit bg-white shadow-sm">
            <span class="text-primary font-mono font-bold text-2xl leading-none">2024</span>
            <div class="w-px h-8 bg-black/10"></div>
            <span class="text-black/60 text-sm leading-tight whitespace-pre-line">{a.storyBadge}</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── ACTIVITIES ───────────────────────────────────── -->
  <section class="py-24 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-14">
        <p class="text-primary font-mono text-xs tracking-[0.2em] uppercase mb-3">{a.activitiesEyebrow}</p>
        <h2 class="text-3xl sm:text-4xl font-black text-white">{a.activitiesTitle}</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {a.activities.map(({ icon, title, desc }) => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/[0.08] hover:border-white/20 hover:-translate-y-1 transition-all duration-300">
            <div class="text-3xl mb-4">{icon}</div>
            <h3 class="text-white font-bold text-lg mb-2">{title}</h3>
            <p class="text-white/50 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>

      <!-- Featured: 地方連携 -->
      <div class="mt-5 bg-white/5 border border-primary/20 rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-start gap-6 hover:bg-white/[0.08] hover:border-primary/40 transition-all duration-300">
        <div class="text-4xl shrink-0">🗾</div>
        <div class="flex-1">
          <p class="text-primary font-mono text-xs tracking-[0.2em] uppercase font-bold mb-2">{a.chihouNewInitiative}</p>
          <h3 class="text-white font-bold text-xl mb-2">{a.chihouTitle2}</h3>
          <p class="text-white/50 text-sm leading-relaxed mb-4">{a.chihouDesc}</p>
          <a href="#chihou" class="inline-flex items-center gap-2 text-primary text-sm font-semibold hover:gap-3 transition-all duration-200">
            {a.chihouDetailLink}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ─── CHIHOU RENKEI ────────────────────────────────── -->
  <section id="chihou" class="py-24 bg-[#0a0a0a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-14">
        <p class="text-primary font-mono text-xs tracking-[0.2em] uppercase mb-3">{a.chihouEyebrow2}</p>
        <h2 class="text-3xl sm:text-4xl font-black text-white leading-tight mb-5">
          {a.chihouSectionTitle}
        </h2>
        <p class="text-white/60 text-base sm:text-lg leading-relaxed max-w-2xl">
          {a.chihouSectionBody}
        </p>
      </div>

      <!-- 5 capabilities -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-14">
        {a.chihouServices.map(({ num, title, desc }) => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/[0.08] transition-colors duration-200">
            <span class="text-primary font-mono text-xs font-bold tracking-widest block mb-3">{num}</span>
            <h3 class="text-white font-bold text-base mb-2">{title}</h3>
            <p class="text-white/50 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>

      <!-- Event ideas -->
      <h3 class="text-white font-black text-xl mb-6">{a.plansTitle}</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-14">
        {a.plans.map(({ label, title, desc }) => (
          <div class="border border-white/10 bg-white/5 rounded-2xl p-6">
            <p class="text-primary font-mono text-xs font-bold tracking-widest mb-3">{label}</p>
            <h4 class="text-white font-bold text-lg mb-2">{title}</h4>
            <p class="text-white/50 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="flex flex-wrap gap-4">
        <a
          href="/akiba-japan-flyer.pdf"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg bg-primary hover:bg-primary-dark text-white font-semibold text-sm transition-colors duration-200 shadow-lg shadow-primary/20"
        >
          {a.flyerCTA}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 2H3a1 1 0 00-1 1v10a1 1 0 001 1h10a1 1 0 001-1v-3M10 2h4v4M8 8l6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href={href("/contact")}
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg border border-white/30 hover:border-white/60 hover:bg-white/5 text-white font-semibold text-sm transition-colors duration-200"
        >
          {a.contactCTA}
        </a>
      </div>

    </div>
  </section>

  <!-- ─── CTA ──────────────────────────────────────────── -->
  <section class="py-24 bg-primary relative overflow-hidden">
    <div class="absolute top-0 right-0 w-72 h-72 rounded-full bg-white/5 -translate-y-1/2 translate-x-1/4" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full bg-black/10 translate-y-1/2 -translate-x-1/4" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <p class="text-white/70 font-mono text-xs tracking-[0.2em] uppercase mb-5">{a.ctaEyebrow}</p>
      <h2 class="text-3xl sm:text-4xl font-black text-white leading-tight mb-5">
        {a.ctaTitle.split("\n").map((line, i) => (
          i === 0 ? <>{line}<br/></> : line
        ))}
      </h2>
      <p class="text-white/75 text-lg max-w-xl mx-auto mb-10 leading-relaxed text-balance">
        {a.ctaBody}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={href("/join")}
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg bg-white text-primary hover:bg-white/90 font-bold text-sm transition-colors duration-200 shadow-lg"
        >
          {a.ctaJoin}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href={href("/contact")}
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg border-2 border-white/60 hover:border-white hover:bg-white/10 text-white font-bold text-sm transition-colors duration-200"
        >
          {a.ctaContact}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 44px 44px;
  }

  .hero-glow {
    background:
      radial-gradient(ellipse at 80% 40%, rgba(232, 84, 106, 0.18) 0%, transparent 55%),
      radial-gradient(ellipse at 10% 75%, rgba(0, 210, 200, 0.08) 0%, transparent 50%);
  }
</style>
