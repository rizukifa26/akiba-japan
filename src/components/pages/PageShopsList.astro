---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, type Lang } from "../../i18n/translations";
import { shops } from "../../data/shops.js";

interface Props {
  lang?: "ja" | "en";
}

const { lang = "ja" } = Astro.props;
const t = useTranslations(lang);
const s = t.shopsList;
const catLabels = t.categoryLabels;

const base = lang === "en" ? "/en" : "/jp";
---

<BaseLayout title={s.pageTitle} description={s.pageDescription} lang={lang}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">

    <!-- Header -->
    <p class="text-primary font-mono text-[10px] tracking-[0.2em] uppercase mb-2">{s.eyebrow}</p>
    <h1 class="text-3xl font-black text-white mb-1">{s.title}</h1>
    <p class="text-white/40 text-sm mb-10">{s.countText(shops.length)}</p>

    <!-- List -->
    <ul class="divide-y divide-white/[0.07]">
      {shops.map((shop) => (
        <li class="flex items-center gap-5 py-4 group">

          <!-- Logo area (left) → 加盟店マップ -->
          <div class="w-36 shrink-0 flex items-center justify-center">
            {shop.logo ? (
              <a
                href={`${base}/shops?shop=${encodeURIComponent(shop.id)}`}
                title={s.mapLinkTitle(shop.name)}
                class="block"
              >
                <img
                  src={shop.logo}
                  alt={`${shop.name} logo`}
                  class="max-h-12 max-w-[140px] w-auto object-contain transition-opacity duration-150 hover:opacity-75"
                />
              </a>
            ) : (
              <a
                href={`${base}/shops?shop=${encodeURIComponent(shop.id)}`}
                title={s.mapLinkTitle(shop.name)}
                class="block"
              >
                <div class="h-12 w-36 bg-white/[0.04] border border-white/10 rounded-lg flex items-center justify-center hover:bg-white/[0.08] transition-colors">
                  <span class="text-white/20 text-[10px] font-mono tracking-wider">MAP</span>
                </div>
              </a>
            )}
          </div>

          <!-- Divider -->
          <div class="w-px h-8 bg-white/10 shrink-0"></div>

          <!-- Shop name (right) -->
          <div class="flex-1 min-w-0">
            {shop.website ? (
              <a
                href={shop.website}
                target="_blank"
                rel="noopener noreferrer"
                class="text-white/80 text-sm font-semibold hover:text-white transition-colors duration-150 leading-snug"
              >
                {shop.name}
              </a>
            ) : (
              <span class="text-white/80 text-sm font-semibold leading-snug">{shop.name}</span>
            )}
            <p class="text-white/30 text-[11px] mt-0.5">{catLabels[shop.category] ?? shop.categoryLabel}</p>
          </div>

        </li>
      ))}
    </ul>

  </div>
</BaseLayout>
