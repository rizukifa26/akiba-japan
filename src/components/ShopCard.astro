---
interface Props {
  id: string;
  name: string;
  category: string;
  categoryLabel: string;
  description: string;
  coinDiscount: number;
  featured?: boolean;
}

const { id, name, category, categoryLabel, description, coinDiscount, featured = false } = Astro.props;

const badgeStyles: Record<string, string> = {
  parts:     "bg-sky-500/15 text-sky-400 border border-sky-500/25",
  cafe:      "bg-amber-500/15 text-amber-400 border border-amber-500/25",
  hobby:     "bg-violet-500/15 text-violet-400 border border-violet-500/25",
  community: "bg-emerald-500/15 text-emerald-400 border border-emerald-500/25",
  halal:     "bg-green-500/15 text-green-400 border border-green-500/25",
  mosque:    "bg-blue-500/15 text-blue-400 border border-blue-500/25",
  souvenirshop: "bg-purple-500/15 text-purple-400 border border-purple-500/25",
  Restaurant: "bg-red-500/15 text-red-400 border border-red-500/25",

  
};

const badge = badgeStyles[category] ?? "bg-white/10 text-white/60 border border-white/15";
---

<article
  class={`shop-card group relative flex flex-col rounded-2xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl overflow-hidden ${
    featured
      ? "bg-white/[0.06] border-primary/40 hover:border-primary/70 hover:shadow-primary/10"
      : "bg-white/[0.03] border-white/10 hover:border-white/25 hover:shadow-black/40"
  }`}
  data-category={category}
  data-shop-id={id}
>
  <!-- Featured ribbon -->
  {featured && (
    <div class="absolute top-4 right-4 z-10">
      <span class="bg-primary text-white text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full">
        おすすめ
      </span>
    </div>
  )}

  <div class="p-6 flex flex-col gap-4 flex-1">

    <!-- Category badge -->
    <div>
      <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${badge}`}>
        {categoryLabel}
      </span>
    </div>

    <!-- Name -->
    <h3 class="text-white font-bold text-lg leading-snug group-hover:text-primary transition-colors duration-200">
      {name}
    </h3>

    <!-- Description -->
    <p class="text-white/55 text-sm leading-relaxed flex-1">
      {description}
    </p>

    <!-- Card footer -->
    <div class="flex items-center justify-between pt-4 border-t border-white/10 mt-auto">

      <!-- Akiba Coin discount -->
      <div class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="7" stroke="#e8546a" stroke-width="1.4"/>
          <text x="8" y="11.5" text-anchor="middle" font-size="7" font-weight="bold" fill="#e8546a" font-family="monospace">AC</text>
        </svg>
        <span class="text-primary font-mono font-bold text-sm">{coinDiscount}%</span>
        <span class="text-white/40 text-xs">割引</span>
      </div>

      <!-- Detail button -->
      <a
        href={`/shops/${id}`}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-white/60 hover:text-white transition-colors duration-200 group/btn"
        aria-label={`${name}の詳細を見る`}
      >
        詳細を見る
        <svg
          class="group-hover/btn:translate-x-0.5 transition-transform duration-200"
          width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
        >
          <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

    </div>
  </div>
</article>
